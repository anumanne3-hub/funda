APP_ENV=development
APP_NAME=genai-chatbot-api
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://genai:genai@localhost:5432/genai_chatbot
DATABASE_POOL_SIZE=3
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=genai_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false
LLM_PROVIDER=mock
LLM_MODEL=mock-stream-v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1000
