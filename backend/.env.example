APP_ENV=development
APP_NAME=genai-chatbot-api
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://genai:genai@localhost:5432/genai_chatbot
DATABASE_POOL_SIZE=3
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=genai_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Optional PostgreSQL migration connection. Supabase CLI uses --db-url (postgresql://).
MIGRATION_DATABASE_URL=
LLM_PROVIDER=mock
LLM_MODEL=mock-stream-v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1000
# Set current model prices before enabling the real provider. Never put keys in VITE_*.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
LLM_DAILY_BUDGET_USD=1
LLM_FREE_TIER=false
LLM_DAILY_REQUEST_LIMIT=100
# Free hosted model: LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.1-flash-lite,
# LLM_FREE_TIER=true, zero prices, and a Google AI Studio key from a free-tier project.
REQUESTS_PER_MINUTE=20
SESSIONS_PER_MINUTE=10
# Exact HTTPS source URLs permitted for project registration; comma separated.
RAG_ALLOWED_SOURCE_URLS=
# Enable only after the GitHub workflow, worker secrets, and migrations are deployed.
RAG_DISPATCH_REPOSITORY=
RAG_DISPATCH_REF=main
RAG_DISPATCH_TOKEN=
# Private bucket and Supabase secret API key (sb_secret_...) used only by backend and worker.
RAG_STORAGE_URL=
RAG_STORAGE_SERVICE_KEY=
RAG_STORAGE_BUCKET=rag-private
# NVIDIA hosted trial for development evaluation only.
RAG_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
RAG_EMBEDDING_DIMENSIONS=2048
RAG_EMBEDDING_API_KEY=
# Enable after retrieval, citations, migrations and hosted acceptance are verified.
RAG_CHAT_ENABLED=false
